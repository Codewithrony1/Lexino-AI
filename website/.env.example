# ==============================================================================
# LEXINO AI — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env.local for development or configure directly in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION
# Production: Use your live Clerk publishable key and secret key.
# Development: Use your test Clerk publishable key and secret key.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://accounts.lexinoai.in/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://accounts.lexinoai.in/sign-up
NEXT_PUBLIC_CLERK_IS_SATELLITE=true

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL / NEON / SUPABASE)
# Connection pooling enabled URL. For serverless, use pooled connection string.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/lexino_prod?sslmode=require&pgbouncer=true

# ------------------------------------------------------------------------------
# 3. AI / LLM INFERENCE PROVIDERS
# Primary inference: Groq Cloud (Llama 3.3 70B, Llama 3.1 8B)
# Optional premium fallbacks: OpenAI & Anthropic
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (RAZORPAY)
# For subscription plans (Student & Pro / Unlimited)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. OPTIONAL MONITORING & ADMIN
# ------------------------------------------------------------------------------
OWNER_OVERRIDE_KEY=your_owner_override_key_here
ADMIN_PASSPHRASE=your_admin_passphrase_here
