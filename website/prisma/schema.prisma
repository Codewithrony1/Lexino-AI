datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StorageState {
  HOT
  COMPRESSED
}

model User {
  id                String        @id // Maps to Clerk User ID (e.g. user_...)
  email             String        @unique
  name              String?
  avatarUrl         String?
  tier              String        @default("FREE") // "FREE" | "STUDENT" | "PRO"
  cooldownUntil     DateTime?
  messageCountToday Int           @default(0)
  lastMessageAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          ChatSession[]
  preferences       Json?         // Stores wallpaper settings, model preference, etc.
  messages          Message[]
  logs              ApiLog[]
  payments          Payment[]
  lastActiveAt      DateTime      @default(now())
  warnedAt          DateTime?
  finalWarnedAt     DateTime?
  cleanupLogs       CleanupLog[]
  storageUsedBytes  BigInt        @default(0)

  @@index([lastActiveAt])
}

model ChatSession {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String       @default("New chat")
  pinned            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  messages          Message[]
  lastInteractionAt DateTime     @default(now())
  storageState      StorageState @default(HOT)
  compressedData    String?      @db.Text

  @@index([userId, storageState])
  @@index([lastInteractionAt])
}

model Message {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String      // "user" | "assistant"
  content    String      @db.Text
  modelUsed  String?     // e.g. "gpt-4o", "claude-3-5-sonnet", etc.
  createdAt  DateTime    @default(now())
  fileUrls   String[]    // List of uploaded file URLs associated with this message

  // PostgreSQL does not create indexes for foreign keys automatically, and this
  // table had none at all - so loading one conversation sequentially scanned every
  // message ever written by every user, getting slower as the table grows.
  //
  // The composite index matches `findMany({ where: { sessionId }, orderBy:
  // { createdAt: 'asc' } })` exactly, so rows come back already ordered and
  // Postgres can skip the sort entirely.
  @@index([sessionId, createdAt])
  // Serves `message.count({ where: { userId } })` and the ON DELETE CASCADE
  // lookup when a user is removed.
  @@index([userId])
}

model ApiLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelUsed String
  tokensUsed Int     @default(0)
  action    String   // "chat" | "image"
  createdAt DateTime @default(now())

  // Required for the ON DELETE SET NULL to find this user's rows without scanning
  // the whole log table.
  @@index([userId])
}

model CleanupLog {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionTier     String
  deletedConversations Int      @default(0)
  deletedMessages      Int      @default(0)
  deletedFiles         Int      @default(0)
  deletedAt            DateTime @default(now())
  reason               String

  @@index([userId])
}

model Payment {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String   @unique
  paymentId         String?  @unique
  signature         String?
  planId            String   // "student" | "pro"
  tier              String   // "STUDENT" | "PRO"
  amount            Int      // in paise (e.g. 14900)
  currency          String   @default("INR")
  status            String   @default("created") // "created" | "paid" | "failed"
  studentIdUploaded String?  // Optional student verification reference / metadata
  receipt           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, createdAt])
}
