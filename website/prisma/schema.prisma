datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String        @id // Maps to Clerk User ID (e.g. user_...)
  email             String        @unique
  name              String?
  avatarUrl         String?
  tier              String        @default("FREE") // "FREE" | "STUDENT" | "PRO"
  cooldownUntil     DateTime?
  messageCountToday Int           @default(0)
  lastMessageAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  sessions          ChatSession[]
  preferences       Json?         // Stores wallpaper settings, model preference, etc.
  messages          Message[]
  logs              ApiLog[]
  lastActiveAt      DateTime      @default(now())
  warnedAt          DateTime?
  finalWarnedAt     DateTime?
  cleanupLogs       CleanupLog[]
  storageUsedBytes  BigInt        @default(0)

  @@index([lastActiveAt])
}

enum StorageState {
  HOT
  COMPRESSED
}

model ChatSession {
  id                String       @id @default(uuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String       @default("New chat")
  pinned            Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  messages          Message[]
  lastInteractionAt DateTime     @default(now())
  storageState      StorageState @default(HOT)
  compressedData    String?      @db.Text

  @@index([userId, storageState])
  @@index([lastInteractionAt])
}

model Message {
  id         String      @id @default(uuid())
  sessionId  String
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String      // "user" | "assistant"
  content    String      @db.Text
  modelUsed  String?     // e.g. "gpt-4o", "claude-3-5-sonnet", etc.
  createdAt  DateTime    @default(now())
  fileUrls   String[]    // List of uploaded file URLs associated with this message
}

model ApiLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  modelUsed String
  tokensUsed Int     @default(0)
  action    String   // "chat" | "image"
  createdAt DateTime @default(now())
}

model CleanupLog {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionTier     String
  deletedConversations Int      @default(0)
  deletedMessages      Int      @default(0)
  deletedFiles         Int      @default(0)
  deletedAt            DateTime @default(now())
  reason               String
}
