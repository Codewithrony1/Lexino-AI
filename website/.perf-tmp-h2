gin\":\"16px 0 8px\",\"color\":\"#e2e8f0\"},\"children\":\"Page Not Found\"}]\na:[\"$\",\"p\",null,{\"style\":{\"color\":\"#a6b6c8\",\"maxWidth\":\"440px\",\"lineHeight\":1.6,\"marginBottom\":\"28px\"},\"children\":\"The page you are looking for does not exist or has been moved.\"}]\nb:[\"$\",\"$L5\",null,{\"href\":\"/\",\"style\":{\"background\":\"linear-gradient(135deg, #10a37f 0%, #34d399 100%)\",\"color\":\"#030506\",\"padding\":\"12px 28px\",\"borderRadius\":\"50px\",\"fontWeight\":700,\"fontSize\":\"14px\",\"textDecoration\":\"none\",\"boxShadow\":\"0 4px 16px rgba(52, 211, 153, 0.25)\"},\"children\":\"Return to Home\"}]\n11:T4dd,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is Lexino AI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Lexino AI is an ultra-fast artificial intelligence chatbot and digital thinking partner designed for study, competitive exam preparation (UPSC, JEE, NEET, GATE), coding interview mastery, and automated productivity.\"}},{\"@type\":\"Question\",\"name\":\"Why is Lexino AI the best AI for exam and interview preparation?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Lexino AI offers instant concept explanations, mock test generation, step-by-step math and science problem solving, DSA coding interview simulation, and personalized revision workflows.\"}},{\"@type\":\"Question\",\"name\":\"How fast is Lexino AI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Lexino AI uses high-speed Server-Sent Events (SSE) token streaming and optimized edge infrastructure to deliver sub-second response times with zero lag and native-app smoothness.\"}},{\"@type\":\"Question\",\"name\":\"Is Lexino AI free for students?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes! Lexino AI offers an Explorer Free Tier with 50 daily queries, as well as a dedicated Student Plan for ₹49/month with GPT-4o access and extended limits.\"}}]}12:T77f6,"])</script><script>self.__next_f.push([1,"\n    \u003c!-- Animated Background --\u003e\n    \u003cdiv class=\"bg-animation\"\u003e\n        \u003cdiv class=\"glow-orb orb-1\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"glow-orb orb-2\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"glow-orb orb-3\"\u003e\u003c/div\u003e\n        \u003cdiv class=\"bg-rings-container\"\u003e\n            \u003cdiv class=\"bg-ring ring-outer\"\u003e\u003c/div\u003e\n            \u003cdiv class=\"bg-ring ring-mid\"\u003e\u003c/div\u003e\n            \u003cdiv class=\"bg-ring ring-inner\"\u003e\u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n    \u003c!-- Background ambience: the \u003caudio\u003e element is created by script.js on the first\n         music-toggle click, so no audio bytes or media element exist on initial load. --\u003e\n    \u003c!-- Navigation --\u003e\n    \u003cnav\u003e\n       \u003cdiv class=\"logo-container\" style=\"display: flex; align-items: center; gap: 12px;\"\u003e\n    \u003cpicture\u003e\n        \u003csource type=\"image/avif\" srcset=\"/lexino-website/logo-96.avif 96w, /lexino-website/logo-160.avif 160w\" sizes=\"48px\"\u003e\n        \u003csource type=\"image/webp\" srcset=\"/lexino-website/logo-96.webp 96w, /lexino-website/logo-160.webp 160w\" sizes=\"48px\"\u003e\n        \u003cimg src=\"/lexino-website/Lexino_AI_Logo-removebg-preview.png\" alt=\"Lexino AI logo\" class=\"brand-logo\" width=\"516\" height=\"484\" decoding=\"async\" style=\"height:45px;width:auto;object-fit:contain;\"\u003e\n    \u003c/picture\u003e\n\n    \u003cdiv class=\"logo\" style=\"margin: 0;\"\u003eLEXINO\u003csup class=\"logo-sup\"\u003eAI\u003c/sup\u003e\u003c/div\u003e\n\u003c/div\u003e\n        \u003cdiv class=\"nav-right\"\u003e\n            \u003cul class=\"nav-links\"\u003e\n                \u003cli\u003e\u003ca href=\"#home\"\u003eHome\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#about\"\u003eAbout\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#features\"\u003eFeatures\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#why\"\u003eWhy Lexino\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#pricing\"\u003ePricing\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#contact\"\u003eContact\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"#careers\"\u003eCareers\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"/terms\" onclick=\"window.location.href='/terms'; return false;\"\u003eTerms\u003c/a\u003e\u003c/li\u003e\n                \u003cli\u003e\u003ca href=\"/privacy\" onclick=\"window.location.href='/privacy'; return false;\"\u003ePrivacy\u003c/a\u003e\u003c/li\u003e\n            \u003c/ul\u003e\n            \u003cbutton class=\"theme-toggle\" onclick=\"toggleTheme()\"\u003e🌓\u003c/button\u003e\n            \u003cbutton class=\"music-toggle\" id=\"musicToggle\" onclick=\"toggleMusic()\"\u003e🔇\u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/nav\u003e\n    \u003cdiv class=\"page-content\"\u003e\n        \u003c!-- Home Page --\u003e\n        \u003cdiv class=\"home-page\" id=\"home-page\"\u003e\n            \u003c!-- Hero Section --\u003e\n            \u003csection class=\"hero\" id=\"home\"\u003e\n                \u003ch1\u003eEmpowering Imagination with Lexino AI — Your Creative Digital Mind.\u003c/h1\u003e\n                \u003cp\u003eLexino AI isn't just another assistant — it's your thinking partner, your creative spark, and your digital mirror that learns, evolves, and grows with you.\u003c/p\u003e\n                \u003cbutton class=\"cta-button\" onclick=\"navigateToTry()\"\u003eExperience Lexino AI Now 🚀\u003c/button\u003e\n                \u003cdiv class=\"video-container\"\u003e\n                    \u003cvideo class=\"demo-preview\" width=\"1280\" height=\"720\"\n                           poster=\"/lexino-website/hero-poster.webp\"\n                           preload=\"none\" loop muted playsinline\n                           data-src-desktop=\"/lexino-website/hero-720.mp4\"\n                           data-src-mobile=\"/lexino-website/hero-480.mp4\"\u003e\u003c/video\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- About Section --\u003e\n            \u003csection class=\"section\" id=\"about\"\u003e\n                \u003ch2\u003eDesigned for Minds That Never Stop Thinking.\u003c/h2\u003e\n                \u003cp style=\"text-align: center; max-width: 800px; margin: 0 auto 3rem; font-size: 1.2rem; line-height: 1.8; opacity: 0.9;\"\u003e\n                    Lexino AI is a next-gen intelligent assistant that adapts to your style, learns from your inputs, and helps you create, plan, and innovate faster than ever. Whether you're writing a new idea, building a startup, or exploring possibilities, Lexino brings clarity, creativity, and control to your digital life.\n                \u003c/p\u003e\n\n\n            \u003c/section\u003e\n            \u003c!-- Features Section --\u003e\n            \u003csection class=\"section\" id=\"features\"\u003e\n                \u003ch2\u003eWhat Makes Lexino AI Different\u003c/h2\u003e\n                \u003cdiv class=\"cards-container\" style=\"grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\"\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e🧠\u003c/div\u003e\n                        \u003ch3\u003eAdaptive Intelligence\u003c/h3\u003e\n                        \u003cp\u003eLearns your workflow, remembers your style, and adapts to how you think — making every interaction more intuitive and personal.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e⚡\u003c/div\u003e\n                        \u003ch3\u003eSeamless Automation\u003c/h3\u003e\n                        \u003cp\u003eGet results instantly. Automate repetitive tasks, generate content, and complete projects in seconds with intelligent processing.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e🔒\u003c/div\u003e\n                        \u003ch3\u003eData-Safe Design\u003c/h3\u003e\n                        \u003cp\u003e100% privacy-focused architecture with end-to-end encryption. Your data stays yours — secure, private, and protected.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e🎨\u003c/div\u003e\n                        \u003ch3\u003e3D Wallpapers\u003c/h3\u003e\n                        \u003cp\u003eTransform your interface into a digital landscape with custom animated 3D wallpapers like Deep Aurora, Neon Matrix, and Smoky Universe.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e🌌\u003c/div\u003e\n                        \u003ch3\u003ePersonalized Spaces\u003c/h3\u003e\n                        \u003cp\u003eCreate organized workspaces with pinned conversations, custom theme accents, and history synced seamlessly across all devices.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e⚡\u003c/div\u003e\n                        \u003ch3\u003eUltra-Fast Streaming\u003c/h3\u003e\n                        \u003cp\u003eA highly optimized, lag-free UI utilizing Server-Sent Events (SSE) to stream responses token-by-token at maximum speed.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e🎓\u003c/div\u003e\n                        \u003ch3\u003eBest AI for Exam Preparation\u003c/h3\u003e\n                        \u003cp\u003eMaster competitive exams (UPSC, JEE, NEET, GATE, GRE) with step-by-step concept breakdowns, mock questions, and intelligent revision guides.\u003c/p\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"card\"\u003e\n                        \u003cdiv class=\"card-icon\"\u003e💻\u003c/div\u003e\n                        \u003ch3\u003eCoding \u0026 Technical Interviews\u003c/h3\u003e\n                        \u003cp\u003eSolve DSA challenges, debug code across Python, C++, Java, and JS, and practice live mock coding interviews with instant AI feedback.\u003c/p\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- Why Section --\u003e\n            \u003csection class=\"section\" id=\"why\"\u003e\n                \u003cdiv class=\"why-section\"\u003e\n                    \u003cdiv class=\"why-visual\"\u003e\n                        \u003cdiv class=\"why-image-card\"\u003e\n                            \u003cpicture\u003e\n                                \u003csource type=\"image/avif\" sizes=\"(max-width: 582px) 195px, (max-width: 1182px) 33vw, 388px\" srcset=\"/lexino-website/Image22-480.avif 480w, /lexino-website/Image22-720.avif 720w, /lexino-website/Image22-969.avif 969w\"\u003e\n                                \u003csource type=\"image/webp\" sizes=\"(max-width: 582px) 195px, (max-width: 1182px) 33vw, 388px\" srcset=\"/lexino-website/Image22-480.webp 480w, /lexino-website/Image22-720.webp 720w, /lexino-website/Image22-969.webp 969w\"\u003e\n                                \u003cimg src=\"/lexino-website/Image22.png\" alt=\"Lexino AI smart assistant preview\" width=\"969\" height=\"1624\" loading=\"lazy\" decoding=\"async\"\u003e\n                            \u003c/picture\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"why-content\"\u003e\n                        \u003ch2\u003eWhy Choose Lexino AI?\u003c/h2\u003e\n                        \u003cp style=\"font-size: 1.1rem; margin-bottom: 1.5rem; opacity: 0.95;\"\u003e\n                            Lexino AI is designed to feel fast, personal, and dependable. It helps you study smarter, build faster, write better, and innovate with confidence.\n                        \u003c/p\u003e\n                        \u003cul class=\"why-list\"\u003e\n                            \u003cli\u003e⚡ \u003cstrong\u003eLightning Fast:\u003c/strong\u003e Process requests and stream responses token-by-token in milliseconds.\u003c/li\u003e\n                            \u003cli\u003e🎓 \u003cstrong\u003eSmarter Study \u0026 Exam Prep:\u003c/strong\u003e Concept breakdowns, revision guides, and mock practice for UPSC, JEE, NEET, \u0026 GATE.\u003c/li\u003e\n                            \u003cli\u003e💻 \u003cstrong\u003eCoding \u0026 Technical Interviews:\u003c/strong\u003e Debug, understand concepts, and practice DSA challenges with instant feedback.\u003c/li\u003e\n                            \u003cli\u003e🔒 \u003cstrong\u003ePrivacy-First Architecture:\u003c/strong\u003e Your data stays private, encrypted, and protected by default.\u003c/li\u003e\n                            \u003cli\u003e🎨 \u003cstrong\u003ePersonalized Spaces \u0026 3D Wallpapers:\u003c/strong\u003e Transform your UI into custom cosmic themes that inspire creative flow.\u003c/li\u003e\n                        \u003c/ul\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- Technology Section --\u003e\n            \u003csection class=\"section\" id=\"technology\"\u003e\n                \u003ch2\u003ePowered by Intelligence. Protected by Trust.\u003c/h2\u003e\n                \u003cp style=\"text-align: center; max-width: 800px; margin: 0 auto; font-size: 1.2rem; line-height: 1.8; opacity: 0.9;\"\u003e\n                   Lexino’s hybrid AI core combines advanced neural intelligence with real-world understanding to deliver fast, contextual, and reliable assistance. From reasoning and research to everyday productivity, Lexino is designed to understand not just what you ask — but why you ask it.\u003cbr\u003e\u003cbr\u003e\n                   \u003cstrong\u003eIntelligent by Design • Private by Default • Built for You\u003c/strong\u003e\n                \u003c/p\u003e\n            \u003c/section\u003e\n            \u003c!-- Community Section --\u003e\n            \u003cdiv class=\"beam beam-l\"\u003e\u003c/div\u003e\n  \u003cdiv class=\"beam beam-r\"\u003e\u003c/div\u003e\n\n  \u003ccanvas id=\"wave-left\"\u003e\u003c/canvas\u003e\n  \u003ccanvas id=\"wave-right\"\u003e\u003c/canvas\u003e\n\n  \u003cdiv class=\"rings\"\u003e\n    \u003csvg viewBox=\"0 0 1750 651\" preserveAspectRatio=\"xMidYMid slice\"\u003e\n      \u003cdefs\u003e\n        \u003clinearGradient id=\"gradL\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"\u003e\n          \u003cstop offset=\"0%\" stop-color=\"#f472b6\" stop-opacity=\"0.55\"/\u003e\n          \u003cstop offset=\"45%\" stop-color=\"#a855f7\" stop-opacity=\"0.5\"/\u003e\n          \u003cstop offset=\"100%\" stop-color=\"#7c3aed\" stop-opacity=\"0\"/\u003e\n        \u003c/linearGradient\u003e\n        \u003clinearGradient id=\"gradR\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\"\u003e\n          \u003cstop offset=\"0%\" stop-color=\"#38bdf8\" stop-opacity=\"0.5\"/\u003e\n          \u003cstop offset=\"45%\" stop-color=\"#6366f1\" stop-opacity=\"0.45\"/\u003e\n          \u003cstop offset=\"100%\" stop-color=\"#6366f1\" stop-opacity=\"0\"/\u003e\n        \u003c/linearGradient\u003e\n      \u003c/defs\u003e\n      \u003ccircle class=\"ring-l\" cx=\"220\" cy=\"330\" r=\"430\" fill=\"none\" stroke=\"url(#gradL)\" stroke-width=\"1.6\"/\u003e\n      \u003ccircle class=\"ring-r\" cx=\"1560\" cy=\"330\" r=\"470\" fill=\"none\" stroke=\"url(#gradR)\" stroke-width=\"1.6\"/\u003e\n    \u003c/svg\u003e\n  \u003c/div\u003e\n\n  \u003cdiv class=\"content\"\u003e\n\n    \u003cdiv class=\"pill\"\u003e\n      \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a78bfa\" stroke-width=\"1.8\"\u003e\u003cpath d=\"M12 3l1.6 5.4L19 10l-5.4 1.6L12 17l-1.6-5.4L5 10l5.4-1.6L12 3z\"/\u003e\u003c/svg\u003e\n      The Future is Intelligent\n    \u003c/div\u003e\n\n    \u003ch1 class=\"headline\"\u003eJoin the \u003cspan class=\"grad\"\u003eLexino Era.\u003c/span\u003e\u003c/h1\u003e\n\n    \u003cp class=\"sub\"\u003e\n      From students to entrepreneurs, Lexino AI is redefining how people create,\n      think, and grow. Step into the next generation of innovation —\n      \u003cspan class=\"accent\"\u003ewhere ideas meet intelligence.\u003c/span\u003e\n    \u003c/p\u003e\n\n    \u003cdiv class=\"features\"\u003e\n      \u003cdiv class=\"feature\"\u003e\n        \u003cdiv class=\"icon-box\"\u003e\n          \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003cpath d=\"M9.5 2a3.5 3.5 0 0 0-3.5 3.5v.6A3 3 0 0 0 4 9v1a3 3 0 0 0 1 2.24V14a3 3 0 0 0 3 3v2a1 1 0 0 0 1 1h1v-6.5\"/\u003e\u003cpath d=\"M9.5 2A3.5 3.5 0 0 1 13 5.5v13\"/\u003e\u003ccircle cx=\"14.5\" cy=\"6\" r=\"0.8\"/\u003e\u003ccircle cx=\"16\" cy=\"10\" r=\"0.8\"/\u003e\u003ccircle cx=\"14.5\" cy=\"14\" r=\"0.8\"/\u003e\u003c/svg\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"text\"\u003e\n          \u003ch3\u003eSmarter AI\u003c/h3\u003e\n          \u003cp\u003eHybrid intelligence that understands you better.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"feature\"\u003e\n        \u003cdiv class=\"icon-box\"\u003e\n          \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003cpath d=\"M12 2l8 3v6c0 5-3.5 8.5-8 11-4.5-2.5-8-6-8-11V5l8-3z\"/\u003e\u003crect x=\"9.5\" y=\"11\" width=\"5\" height=\"4\" rx=\"0.6\"/\u003e\u003cpath d=\"M10.5 11V9.5a1.5 1.5 0 0 1 3 0V11\"/\u003e\u003c/svg\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"text\"\u003e\n          \u003ch3\u003ePrivacy First\u003c/h3\u003e\n          \u003cp\u003eYour data stays private, always encrypted.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"feature\"\u003e\n        \u003cdiv class=\"icon-box\"\u003e\n          \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003cpath d=\"M13 2 4 14h6l-1 8 9-12h-6l1-8z\"/\u003e\u003c/svg\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"text\"\u003e\n          \u003ch3\u003eBoost Productivity\u003c/h3\u003e\n          \u003cp\u003eWrite, research, plan, and create 10x faster.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n\n      \u003cdiv class=\"feature\"\u003e\n        \u003cdiv class=\"icon-box\"\u003e\n          \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003ccircle cx=\"9\" cy=\"8\" r=\"3\"/\u003e\u003cpath d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\"/\u003e\u003ccircle cx=\"17\" cy=\"9\" r=\"2.4\"/\u003e\u003cpath d=\"M15.5 14.2c2.4.3 4.3 2.3 4.3 4.8\"/\u003e\u003c/svg\u003e\n        \u003c/div\u003e\n        \u003cdiv class=\"text\"\u003e\n          \u003ch3\u003eFor Everyone\u003c/h3\u003e\n          \u003cp\u003eStudents, creators, professionals — all in one.\u003c/p\u003e\n        \u003c/div\u003e\n      \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003cdiv class=\"bottom-pill\"\u003e\n      \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"\u003e\u003cpath d=\"M12 21s-7.5-4.6-10-9.2C.5 8.3 2.2 5 5.6 5 8 5 9.6 6.4 12 9c2.4-2.6 4-4 6.4-4 3.4 0 5.1 3.3 3.6 6.8C19.5 16.4 12 21 12 21z\"/\u003e\u003c/svg\u003e\n      Built with intelligence. Driven by purpose. Made for you.\n    \u003c/div\u003e\n\n  \u003c/div\u003e\n\u003c/section\u003e\n            \u003c!-- Pricing Section --\u003e\n            \u003csection class=\"section\" id=\"pricing\"\u003e\n                \u003ch2\u003eChoose Your Intelligence Plan\u003c/h2\u003e\n                \u003cp style=\"text-align: center; max-width: 700px; margin: 0 auto 3rem; font-size: 1.1rem; opacity: 0.9;\"\u003e\n                    Flexible pricing for everyone — from curious explorers to power users. Start free, scale as you grow.\n                \u003c/p\u003e\n                \u003cdiv class=\"pricing-container\"\u003e\n                    \u003cdiv class=\"pricing-card\"\u003e\n                        \u003cdiv class=\"plan-badge\"\u003eFREE\u003c/div\u003e\n                        \u003ch3\u003eExplorer\u003c/h3\u003e\n                        \u003cdiv class=\"price\"\u003e\n                            \u003cdiv class=\"original-price\"\u003e\n                                \u003cspan\u003e₹199\u003c/span\u003e\n                                \u003cdiv class=\"strike-line\"\u003e\u003c/div\u003e\n                            \u003c/div\u003e\n                            \u003cdiv class=\"current-price\"\u003e\n                                \u003cspan class=\"amount\"\u003e₹0\u003c/span\u003e\n                                \u003cspan class=\"period\"\u003e/month\u003c/span\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                        \u003cul class=\"features-list\"\u003e\n                            \u003cli\u003e✓ 50 queries per day\u003c/li\u003e\n                            \u003cli\u003e✓ Basic text generation\u003c/li\u003e\n                            \u003cli\u003e✓ Standard response speed\u003c/li\u003e\n                            \u003cli\u003e✓ 6 smooth celestial wallpapers\u003c/li\u003e\n                            \u003cli\u003e✓ Access to core features\u003c/li\u003e\n                        \u003c/ul\u003e\n                        \u003cbutton class=\"pricing-button secondary\" onclick=\"navigateToTry()\"\u003eGet Started\u003c/button\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"pricing-card\"\u003e\n                        \u003cdiv class=\"plan-badge\"\u003eSTUDENT\u003c/div\u003e\n                        \u003ch3\u003eStudent\u003c/h3\u003e\n                        \u003cdiv class=\"price\"\u003e\n                            \u003cdiv class=\"original-price\"\u003e\n                                \u003cspan\u003e₹399\u003c/span\u003e\n                                \u003cdiv class=\"strike-line\"\u003e\u003c/div\u003e\n                            \u003c/div\u003e\n                            \u003cdiv class=\"current-price\"\u003e\n                                \u003cspan class=\"amount\"\u003e₹49\u003c/span\u003e\n                                \u003cspan class=\"period\"\u003e/month\u003c/span\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                        \u003cul class=\"features-list\"\u003e\n                            \u003cli\u003e✓ 300 queries per day\u003c/li\u003e\n                            \u003cli\u003e✓ ChatGPT (GPT-4o) access included\u003c/li\u003e\n                            \u003cli\u003e✓ Ideal for exam prep (UPSC, JEE, NEET, GATE)\u003c/li\u003e\n                            \u003cli\u003e✓ Advanced text generation\u003c/li\u003e\n                            \u003cli\u003e✓ Priority response speed\u003c/li\u003e\n                            \u003cli\u003e✓ Unlock all 13 premium space \u0026 3D wallpapers\u003c/li\u003e\n                            \u003cli\u003e✓ Code generation support\u003c/li\u003e\n                            \u003cli\u003e✓ Save conversations\u003c/li\u003e\n                            \u003cli\u003e✓ Valid student ID required\u003c/li\u003e\n                        \u003c/ul\u003e\n                        \u003cbutton class=\"pricing-button secondary\" id=\"studentCheckoutBtn\" onclick=\"openPlanCheckout('student')\"\u003eGet Student Plan\u003c/button\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"pricing-card featured\"\u003e\n                        \u003cdiv class=\"plan-badge popular\"\u003eBEST VALUE\u003c/div\u003e\n                        \u003ch3\u003ePro\u003c/h3\u003e\n                        \u003cdiv class=\"price\"\u003e\n                            \u003cdiv class=\"original-price\"\u003e\n                                \u003cspan\u003e₹499\u003c/span\u003e\n                                \u003cdiv class=\"strike-line\"\u003e\u003c/div\u003e\n                            \u003c/div\u003e\n                            \u003cdiv class=\"current-price\"\u003e\n                                \u003cspan class=\"amount\"\u003e₹299\u003c/span\u003e\n                                \u003cspan class=\"period\"\u003e/month\u003c/span\u003e\n                            \u003c/div\u003e\n                        \u003c/div\u003e\n                        \u003cul class=\"features-list\"\u003e\n                            \u003cli\u003e✓ 1500 queries per day\u003c/li\u003e\n                            \u003cli\u003e✓ Both ChatGPT \u0026 Claude Sonnet included\u003c/li\u003e\n                            \u003cli\u003e✓ Priority response speed\u003c/li\u003e\n                            \u003cli\u003e✓ Code generation \u0026 debugging\u003c/li\u003e\n                            \u003cli\u003e✓ Voice \u0026 chat integration\u003c/li\u003e\n                            \u003cli\u003e✓ Unlimited premium \u0026 3D wallpapers\u003c/li\u003e\n                            \u003cli\u003e✓ Deep personalization \u0026 workspaces\u003c/li\u003e\n                            \u003cli\u003e✓ Priority support\u003c/li\u003e\n                        \u003c/ul\u003e\n                        \u003cbutton class=\"pricing-button primary\" id=\"proCheckoutBtn\" onclick=\"openPlanCheckout('pro')\"\u003eGet Pro Access\u003c/button\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- Contact Section --\u003e\n            \u003csection class=\"section\" id=\"contact\"\u003e\n                \u003cdiv class=\"why-section single-panel\" style=\"max-width: 800px; margin: 0 auto;\"\u003e\n                    \u003ch2\u003eConnect with Lexino AI Systems\u003c/h2\u003e\n                    \u003cp style=\"text-align: center; font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.9;\"\u003e\n                        Have questions about our AI models, student discounts, or institutional partnerships? Our engineering and support team is available 24/7.\n                    \u003c/p\u003e\n                    \u003cdiv class=\"cards-container\" style=\"grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-bottom: 1rem;\"\u003e\n                        \u003cdiv class=\"card\" style=\"text-align: center;\"\u003e\n                            \u003cdiv class=\"card-icon\"\u003e✉️\u003c/div\u003e\n                            \u003ch3\u003eDirect Support\u003c/h3\u003e\n                            \u003cp style=\"margin-top: 0.5rem;\"\u003e\u003ca href=\"mailto:support@lexinoai.in\" style=\"color: var(--color-accent); text-decoration: none; font-weight: 600;\"\u003esupport@lexinoai.in\u003c/a\u003e\u003c/p\u003e\n                            \u003cp style=\"font-size: 0.85rem; opacity: 0.7; margin-top: 4px;\"\u003eAverage response time: \u0026lt; 2 hours\u003c/p\u003e\n                        \u003c/div\u003e\n                        \u003cdiv class=\"card\" style=\"text-align: center;\"\u003e\n                            \u003cdiv class=\"card-icon\"\u003e⚡\u003c/div\u003e\n                            \u003ch3\u003eLive Workspace\u003c/h3\u003e\n                            \u003cp style=\"margin-top: 0.5rem; color: #34d399; font-weight: 600;\"\u003e\u003ca href=\"/chat\" style=\"color: #34d399; text-decoration: none;\"\u003eLaunch Chat Assistant\u003c/a\u003e\u003c/p\u003e\n                            \u003cp style=\"font-size: 0.85rem; opacity: 0.7; margin-top: 4px;\"\u003eInstant AI troubleshooting \u0026 queries\u003c/p\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- Careers Section --\u003e\n            \u003csection class=\"section\" id=\"careers\"\u003e\n                \u003cdiv class=\"why-section single-panel\" style=\"max-width: 850px; margin: 0 auto;\"\u003e\n                    \u003ch2\u003eBuild the Next-Generation AI Ecosystem\u003c/h2\u003e\n                    \u003cp style=\"text-align: center; font-size: 1.1rem; margin-bottom: 2rem; opacity: 0.9;\"\u003e\n                        We are looking for passionate builders, researchers, and designers to shape the future of intelligent education and workspace operating systems.\n                    \u003c/p\u003e\n                    \u003cdiv class=\"cards-container\" style=\"grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\"\u003e\n                        \u003cdiv class=\"card\"\u003e\n                            \u003cdiv class=\"plan-badge\" style=\"background: rgba(0, 240, 255, 0.15); color: #00f0ff; margin-bottom: 0.75rem;\"\u003eOPEN ROLE\u003c/div\u003e\n                            \u003ch3\u003eAI Systems Engineer\u003c/h3\u003e\n                            \u003cp style=\"font-size: 0.9rem; opacity: 0.8; margin: 0.5rem 0 1rem;\"\u003eWork on low-latency LLM inference pipelines, model evaluation, and adaptive neural agents.\u003c/p\u003e\n                            \u003ca href=\"mailto:careers@lexinoai.in?subject=Application:%20AI%20Systems%20Engineer\" class=\"pricing-button secondary\" style=\"display: inline-block; text-align: center; text-decoration: none; padding: 8px 16px; font-size: 0.85rem;\"\u003eApply Now →\u003c/a\u003e\n                        \u003c/div\u003e\n                        \u003cdiv class=\"card\"\u003e\n                            \u003cdiv class=\"plan-badge\" style=\"background: rgba(168, 85, 247, 0.15); color: #a855f7; margin-bottom: 0.75rem;\"\u003eOPEN ROLE\u003c/div\u003e\n                            \u003ch3\u003eFull Stack Next.js Builder\u003c/h3\u003e\n                            \u003cp style=\"font-size: 0.9rem; opacity: 0.8; margin: 0.5rem 0 1rem;\"\u003eArchitect ultra-fast glassmorphism interfaces, edge state management, and real-time SSE streaming.\u003c/p\u003e\n                            \u003ca href=\"mailto:careers@lexinoai.in?subject=Application:%20Full%20Stack%20Next.js%20Builder\" class=\"pricing-button secondary\" style=\"display: inline-block; text-align: center; text-decoration: none; padding: 8px 16px; font-size: 0.85rem;\"\u003eApply Now →\u003c/a\u003e\n                        \u003c/div\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/section\u003e\n            \u003c!-- Footer --\u003e\n            \u003cfooter class=\"futuristic-footer\"\u003e\n                \u003cdiv class=\"footer-divider\"\u003e\u003c/div\u003e\n                \u003cdiv class=\"footer-content\"\u003e\n                    \u003cp class=\"footer-credit\"\u003e© 2026 Lexino AI • All Rights Reserved\u003c/p\u003e\n                    \u003cdiv class=\"footer-socials\"\u003e\n                        \u003ca href=\"https://www.instagram.com/lexino.ai/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"social-icon instagram\" title=\"Instagram\"\u003e\n                            \u003csvg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"vertical-align: middle;\"\u003e\n                                \u003crect x=\"2\" y=\"2\" width=\"20\" height=\"20\" rx=\"5\" ry=\"5\"\u003e\u003c/rect\u003e\n                                \u003cpath d=\"M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z\"\u003e\u003c/path\u003e\n                                \u003cline x1=\"17.5\" y1=\"6.5\" x2=\"17.51\" y2=\"6.5\"\u003e\u003c/line\u003e\n                            \u003c/svg\u003e\n                            \u003cspan\u003eInstagram\u003c/span\u003e\n                        \u003c/a\u003e\n                        \u003ca href=\"#\" onclick=\"event.preventDefault()\" class=\"social-icon placeholder\" title=\"Future Social Matrix\"\u003e\n                            \u003cspan class=\"placeholder-dot\"\u003e\u003c/span\u003e\n                            \u003cspan\u003eMatrix\u003c/span\u003e\n                        \u003c/a\u003e\n                        \u003ca href=\"#\" onclick=\"event.preventDefault()\" class=\"social-icon placeholder\" title=\"Future Social Discord\"\u003e\n                            \u003cspan class=\"placeholder-dot\"\u003e\u003c/span\u003e\n                            \u003cspan\u003eDiscord\u003c/span\u003e\n                        \u003c/a\u003e\n                    \u003c/div\u003e\n                    \u003cdiv class=\"footer-links\"\u003e\n                        \u003ca href=\"/terms\" onclick=\"window.location.href='/terms'; return false;\"\u003eTerms\u003c/a\u003e\n                        \u003ca href=\"/privacy\" onclick=\"window.location.href='/privacy'; return false;\"\u003ePrivacy\u003c/a\u003e\n                        \u003ca href=\"#contact\"\u003eContact\u003c/a\u003e\n                        \u003ca href=\"#careers\"\u003eCareers\u003c/a\u003e\n                    \u003c/div\u003e\n                \u003c/div\u003e\n            \u003c/footer\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Student Verification Modal --\u003e\n    \u003cdiv class=\"lexino-modal-overlay\" id=\"studentVerificationModal\" style=\"display: none;\" onclick=\"if(event.target === this) closeStudentModal()\"\u003e\n        \u003cdiv class=\"lexino-modal-card\" onclick=\"event.stopPropagation()\"\u003e\n            \u003cdiv class=\"modal-header\"\u003e\n                \u003cdiv style=\"display: flex; align-items: center; gap: 10px;\"\u003e\n                    \u003cspan style=\"font-size: 1.5rem;\"\u003e🎓\u003c/span\u003e\n                    \u003ch3 style=\"margin: 0; font-family: var(--font-orbitron), 'Orbitron', sans-serif; font-size: 1.25rem;\"\u003eStudent Verification\u003c/h3\u003e\n                \u003c/div\u003e\n                \u003cbutton class=\"modal-close\" onclick=\"closeStudentModal()\" aria-label=\"Close modal\"\u003e✕\u003c/button\u003e\n            \u003c/div\u003e\n            \u003cp style=\"margin: 1rem 0 1.5rem; font-size: 0.9rem; opacity: 0.8; line-height: 1.6;\"\u003e\n                The \u003cstrong\u003eStudent Plan (₹49/month)\u003c/strong\u003e is subsidized exclusively for students preparing for competitive exams (UPSC, JEE, NEET, GATE) and college curricula.\n            \u003c/p\u003e\n            \u003cform id=\"studentVerificationForm\" onsubmit=\"handleStudentVerificationSubmit(event)\"\u003e\n                \u003cdiv class=\"form-group\" style=\"margin-bottom: 1.2rem; text-align: left;\"\u003e\n                    \u003clabel style=\"display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--color-accent);\"\u003eCollege / School / Coaching Institute\u003c/label\u003e\n                    \u003cinput type=\"text\" id=\"studentInstitute\" class=\"lexino-input\" placeholder=\"e.g. IIT Bombay, Delhi University, Allen, FIITJEE...\" required\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"form-group\" style=\"margin-bottom: 1.2rem; text-align: left;\"\u003e\n                    \u003clabel style=\"display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--color-accent);\"\u003eTarget Exam or Degree Course\u003c/label\u003e\n                    \u003cinput type=\"text\" id=\"studentCourse\" class=\"lexino-input\" placeholder=\"e.g. JEE Advanced 2026, UPSC CSE, B.Tech AI \u0026 DS...\" required\u003e\n                \u003c/div\u003e\n                \u003cdiv class=\"form-group\" style=\"margin-bottom: 1.5rem; text-align: left;\"\u003e\n                    \u003clabel style=\"display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; color: var(--color-accent);\"\u003eStudent Roll Number / Enrollment ID\u003c/label\u003e\n                    \u003cinput type=\"text\" id=\"studentRollId\" class=\"lexino-input\" placeholder=\"e.g. 2024-CS-042 / Roll No\" required\u003e\n                \u003c/div\u003e\n                \u003cdiv style=\"display: flex; gap: 12px; justify-content: flex-end; align-items: center;\"\u003e\n                    \u003cbutton type=\"button\" class=\"pricing-button secondary\" onclick=\"closeStudentModal()\" style=\"padding: 10px 20px;\"\u003eCancel\u003c/button\u003e\n                    \u003cbutton type=\"submit\" class=\"pricing-button primary\" id=\"studentSubmitBtn\" style=\"padding: 10px 24px;\"\u003eProceed to Pay ₹49 🔒\u003c/button\u003e\n                \u003c/div\u003e\n            \u003c/form\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Payment Success Modal --\u003e\n    \u003cdiv class=\"lexino-modal-overlay\" id=\"paymentSuccessModal\" style=\"display: none;\" onclick=\"if(event.target === this) closeSuccessModal()\"\u003e\n        \u003cdiv class=\"lexino-modal-card\" style=\"text-align: center; border-color: rgba(52, 211, 153, 0.4); box-shadow: 0 0 40px rgba(52, 211, 153, 0.2);\" onclick=\"event.stopPropagation()\"\u003e\n            \u003cdiv style=\"font-size: 3.5rem; margin-bottom: 1rem; animation: pulse 2s infinite;\"\u003e🎉\u003c/div\u003e\n            \u003ch3 style=\"font-family: var(--font-orbitron), 'Orbitron', sans-serif; font-size: 1.5rem; color: #34d399; margin-bottom: 0.5rem;\"\u003ePayment Successful!\u003c/h3\u003e\n            \u003cp id=\"successPlanText\" style=\"font-size: 1.05rem; margin-bottom: 1.5rem; opacity: 0.9;\"\u003eYour Lexino AI Plan has been activated.\u003c/p\u003e\n            \u003cdiv style=\"background: rgba(52, 211, 153, 0.1); border: 1px solid rgba(52, 211, 153, 0.2); border-radius: 12px; padding: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: #e2e8f0; text-align: left;\"\u003e\n                ✓ Priority neural response streaming unlocked\u003cbr\u003e\n                ✓ High-capacity daily queries allocated\u003cbr\u003e\n                ✓ Premium 3D celestial spaces unlocked\n            \u003c/div\u003e\n            \u003cbutton class=\"pricing-button primary\" onclick=\"window.location.href='/chat'\" style=\"width: 100%; background: #10b981; font-weight: 700; padding: 12px;\"\u003eLaunch Workspace 🚀\u003c/button\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \u003c!-- Payment Failure / Dismissal Modal --\u003e\n    \u003cdiv class=\"lexino-modal-overlay\" id=\"paymentFailureModal\" style=\"display: none;\" onclick=\"if(event.target === this) closeFailureModal()\"\u003e\n        \u003cdiv class=\"lexino-modal-card\" style=\"text-align: center; border-color: rgba(245, 158, 11, 0.35);\" onclick=\"event.stopPropagation()\"\u003e\n            \u003cdiv style=\"font-size: 3rem; margin-bottom: 1rem;\"\u003e⚠️\u003c/div\u003e\n            \u003ch3 style=\"font-family: var(--font-orbitron), 'Orbitron', sans-serif; font-size: 1.35rem; color: #f59e0b; margin-bottom: 0.5rem;\"\u003ePayment Incomplete\u003c/h3\u003e\n            \u003cp id=\"failureReasonText\" style=\"font-size: 0.95rem; margin-bottom: 1.5rem; opacity: 0.85; line-height: 1.6;\"\u003e\n                The transaction was not completed. No charges were made to your account.\n            \u003c/p\u003e\n            \u003cdiv style=\"display: flex; gap: 12px; justify-content: center;\"\u003e\n                \u003cbutton class=\"pricing-button secondary\" onclick=\"closeFailureModal()\" style=\"padding: 10px 20px;\"\u003eDismiss\u003c/button\u003e\n                \u003cbutton class=\"pricing-button primary\" id=\"retryPaymentBtn\" onclick=\"retryLastPayment()\" style=\"padding: 10px 24px;\"\u003eTry Again 🔄\u003c/button\u003e\n            \u003c/div\u003e\n        \u003c/div\u003e\n    \u003c/div\u003e\n\n    \n"])</script><script>self.__next_f.push([1,"c:[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$11\"}}],[\"$\",\"link\",null,{\"rel\":\"stylesheet\",\"href\":\"/lexino-website/styles.css\"}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"$12\"}}],\"$L13\"],null,\"$L14\"]}]\n15:[]\nd:\"$W15\"\ne:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L16\",null,{\"children\":\"$L17\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L18\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1a\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n10:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0mo.76pk06_ak.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"1b:I[97367,[\"/_next/static/chunks/0ehi28~hczvpv.js\",\"/_next/static/chunks/0d3shmwh5_nmn.js\"],\"OutletBoundary\"]\n13:[\"$\",\"script\",null,{\"defer\":true,\"src\":\"/lexino-website/script.js\"}]\n14:[\"$\",\"$L1b\",null,{\"children\":[\"$\",\"$19\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@1c\"}]}]\n"])</script><script>self.__next_f.push([1,"17:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, maximum-scale=5\"}],[\"$\",\"meta\",\"2\",